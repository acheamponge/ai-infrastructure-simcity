# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://atlas:atlas@localhost:5433/atlas?schema=public"

# Meta Model API. Research, extraction and the planner run on Muse Spark; the advisor's verdict and build plan
# run on Muse Wonder and fall back to Spark if Wonder is unavailable or slow. SAM 3.1 measures sites, Muse Image renders them.
# When MODEL_API_KEY_MUSE is set, Muse answers first and Crusoe is the fallback. LLM_PROVIDER=crusoe flips that.
MODEL_API_KEY_MUSE=""
META_BASE_URL="https://api.meta.ai/v1"
META_MODEL_RESEARCH="muse-spark-1.3"
META_MODEL_ADVISOR="muse-wonder-1.0"
META_MODEL_PLANNER="muse-spark-1.3"
# LLM_PROVIDER="meta"

# Crusoe Cloud managed inference (OpenAI-compatible). Model hints are resolved against /v1/models,
# or give exact ids. The advisor uses GLM 5.3. Research and extraction ask for Kimi and fall
# back to GLM 5.3 Flash when the endpoint does not serve a Kimi model.
# Values here win over variables of the same name exported in your shell.
CRUSOE_API_KEY=""
CRUSOE_BASE_URL="https://api.inference.crusoecloud.com/v1"
CRUSOE_MODEL_RESEARCH="kimi"
CRUSOE_MODEL_ADVISOR="glm"

# Tavily web search
TAVILY_API_KEY=""

# Force "live" or "fixture"; by default live when both keys are present.
# ATLAS_AGENT_MODE=""
