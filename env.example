# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://atlas:atlas@localhost:5433/atlas?schema=public"

# Crusoe Cloud inference (OpenAI-compatible). Model hints are resolved against /v1/models,
# or give exact ids. The advisor uses GLM 5.3. Research and extraction ask for Kimi and fall
# back to GLM 5.3 Flash when the endpoint does not serve a Kimi model.
# Values here win over variables of the same name exported in your shell.
CRUSOE_API_KEY=""
CRUSOE_BASE_URL="https://api.inference.crusoecloud.com/v1"
CRUSOE_MODEL_RESEARCH="kimi"
CRUSOE_MODEL_ADVISOR="glm"

# Tavily web search
TAVILY_API_KEY=""

# Force "live" or "fixture"; by default live when both keys are present.
# ATLAS_AGENT_MODE=""
